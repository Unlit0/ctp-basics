    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="tempcelcius" type="Real" array="False" size=""/>
            <output expression="&quot;enter the given temperature in celcius&quot;" newline="True"/>
            <input variable="tempcelcius"/>
            <output expression="&quot;the tempreature in fahrenheit is&quot;&amp; &quot; : &quot;&amp; (tempcelcius*1.8)+32" newline="True"/>
