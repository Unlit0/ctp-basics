<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="grade by marks"/>
        <attribute name="authors" value="Dell"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-07 09:53:12 AM"/>
        <attribute name="created" value="RGVsbDtERVNLVE9QLTVWM1JEQkc7MjAyNi0xMC0wNzswOTo0Njo1MyBBTTsyNzE5"/>
        <attribute name="edited" value="RGVsbDtERVNLVE9QLTVWM1JEQkc7MjAyNi0xMC0wNzswOTo1MzoxMiBBTTsxOzI4MjA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="grade" type="Integer" array="False" size=""/>
            <output expression="&quot;enter your marks:&quot;" newline="True"/>
            <input variable="grade"/>
            <if expression="grade&gt;=85">
                <then>
                    <output expression="&quot;your grade is A&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="grade&gt;=65">
                        <then>
                            <output expression="&quot;grade is B&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="grade&gt;=41">
                                <then>
                                    <output expression="&quot;your grade is c&quot;" newline="True"/>
                                </then>
                                <else>
                                    <if expression="grade&lt;=40">
                                        <then>
                                            <output expression="&quot;your grade is F&quot;" newline="True"/>
                                        </then>
                                        <else/>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
