<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="even and odd"/>
        <attribute name="authors" value="Dell"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-07 09:24:21 AM"/>
        <attribute name="created" value="RGVsbDtERVNLVE9QLTVWM1JEQkc7MjAyNi0xMC0wNzswOToyMToxOCBBTTsyNzEz"/>
        <attribute name="edited" value="RGVsbDtERVNLVE9QLTVWM1JEQkc7MjAyNi0xMC0wNzswOToyNDoyMSBBTTsxOzI4MTg="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num" type="Real" array="False" size=""/>
            <output expression="&quot;enter a number&quot;" newline="True"/>
            <input variable="num"/>
            <if expression="num%2=0">
                <then>
                    <output expression="&quot;number is even&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;number is odd&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
